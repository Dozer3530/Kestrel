# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Windows scripts need CRLF locally.
*.bat text eol=crlf

# Binary assets: no line-ending munging, no text diffs.
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.svg  text
*.gpkg binary
*.tif  binary
*.tiff binary
*.zip  binary
*.shp  binary
*.dbf  binary
*.shx  binary
